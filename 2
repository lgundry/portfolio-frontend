div.introContainer {
  flex: 1;
  align-content: center;
  justify-content: center;
}

div.intro {
  display: flex;
  flex-direction: row;
  align-content: center;
  align-self: center;
  width: 90vh;

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 10%;
  box-shadow: 10%;
}

.intro__text {
  flex: 1;
  width: 70%;
  align-content: center;
}

.intro__headshot {
  margin: 5%;
  flex: 0 0 25%;
  width: 25%;
  border-radius: 50%;
  aspect-ratio: 1 / 1;
  align-self: center;
}

.intro__supertext {
  text-align: right;
}

.intro__subtext {
  text-align: right;
}
